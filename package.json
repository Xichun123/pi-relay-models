{
  "name": "pi-relay-models",
  "version": "0.4.0",
  "type": "module",
  "description": "Mixed-protocol relay model discovery and metadata matching for pi",
  "license": "MIT",
  "author": "Xichun123",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xichun123/pi-relay-models.git"
  },
  "homepage": "https://github.com/Xichun123/pi-relay-models#readme",
  "bugs": {
    "url": "https://github.com/Xichun123/pi-relay-models/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "llm",
    "relay",
    "openai",
    "anthropic"
  ],
  "files": [
